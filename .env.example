# Path to your Obsidian vault. The web app AND the Obsidian plugin must use this same folder.
JARVIS_VAULT=~/Obsidian/MyVault

# Required if you bind to anything other than 127.0.0.1
JARVIS_TOKEN=
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765

# Any OpenAI-compatible endpoint. OpenRouter lets one key serve both tiers.
JARVIS_LLM_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
JARVIS_FAST_MODEL=anthropic/claude-haiku-5.5
JARVIS_FRONTIER_MODEL=anthropic/claude-opus-5.5
# Optional per-mode overrides, e.g. run "code" mode on a different frontier model:
# JARVIS_CODE_MODEL=openai/gpt-6-astra
# JARVIS_BUILD_MODEL=

# Router: score >= threshold goes to the frontier model
JARVIS_TIER3_THRESHOLD=3

# Off by default: lets the brain execute Python on this machine (not a real sandbox).
JARVIS_ALLOW_CODE_EXEC=0

# Local voice (pip install -e '.[voice]')
JARVIS_WHISPER_MODEL=base.en
JARVIS_KOKORO_VOICE=af_heart
