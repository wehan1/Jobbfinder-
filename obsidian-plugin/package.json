{
  "name": "jarvis-obsidian-plugin",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "build": "tsc --noEmit && esbuild main.ts --bundle --external:obsidian --external:electron --format=cjs --target=es2020 --outfile=main.js",
    "dev": "esbuild main.ts --bundle --external:obsidian --external:electron --format=cjs --target=es2020 --outfile=main.js --watch"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "obsidian": "latest",
    "typescript": "^5.6.0"
  }
}
